---
import ColorBends from './ColorBends/ColorBends'
import AnimatedGlobe from '@/components/AnimatedGlobe.astro'
import Clock from '@/components/Clock.astro'

function buildCells(cols: number, rows: number, colorClass: string) {
  return Array.from({ length: cols * rows }, (_, i) => {
    const col = i % cols
    const row = Math.floor(i / cols)
    const isLastCol = col === cols - 1
    const isLastRow = row === rows - 1

    const classes = [colorClass]
    if (!isLastCol) classes.push('border-r')
    if (!isLastRow) classes.push('border-b')

    return classes.join(' ')
  })
}

const desktopCols = 5
const desktopRows = 3
const desktopCells = buildCells(desktopCols, desktopRows, 'border-white/15')
const desktopRedCells = buildCells(
  desktopCols,
  desktopRows,
  'border-red-500/50',
)

const mobileCols = 4
const mobileRows = 3
const mobileCells = buildCells(mobileCols, mobileRows, 'border-white/15')

const mobileRowsClass = 'grid-rows-3'

const bio = `Desenvolvedor Front-end há mais de 5 anos, com foco em web e mobile.
Também atuo como designer, criando interfaces pensadas para melhorar
experiência de uso e aumentar conversão.`
---

<section
  id="hero-section"
  class="relative w-screen h-screen bg-black overflow-hidden"
  style="--mx: 50%; --my: 50%;"
>
  <div class="w-full h-full">
    <!-- Ilha React com a animação de ondas -->
    <div class="absolute inset-0">
      <ColorBends
        client:visible
        rotation={90}
        speed={0.2}
        colors={['#3e3e41', '#1c1c1c', '#2d302d']}
        transparent
        autoRotate={0}
        scale={1.6}
        frequency={2.7}
        warpStrength={0.9}
        mouseInfluence={0}
        parallax={0.1}
        noise={0.25}
        iterations={4}
        intensity={1.2}
        bandWidth={7}
      />
    </div>

    <!-- Linhas da grid (mobile) -->
    <div
      class={`pointer-events-none absolute inset-0 z-10 grid h-full w-full grid-cols-[1.25rem_1fr_1fr_1.25rem] ${mobileRowsClass} md:hidden`}
    >
      {mobileCells.map((cellClass) => <div class={cellClass} />)}
    </div>

    <!-- Linhas da grid (desktop) -->
    <div
      class="pointer-events-none absolute inset-0 z-10 hidden h-full w-full grid-cols-[3.5rem_1fr_1fr_1fr_3.5rem] grid-rows-3 md:grid"
    >
      {desktopCells.map((cellClass) => <div class={cellClass} />)}
    </div>

    <!-- Linhas da grid em vermelho -->
    <div
      id="hero-grid-red"
      class="pointer-events-none absolute inset-0 z-10 hidden h-full w-full grid-cols-[3.5rem_1fr_1fr_1fr_3.5rem] grid-rows-3 opacity-0 transition-opacity duration-300 md:grid"
      style="mask-image: radial-gradient(180px circle at var(--mx) var(--my), black, transparent 70%); -webkit-mask-image: radial-gradient(180px circle at var(--mx) var(--my), black, transparent 70%);"
    >
      {desktopRedCells.map((cellClass) => <div class={cellClass} />)}
    </div>

    <div
      class={`relative z-20 grid h-full w-full grid-cols-[1.25rem_1fr_1fr_1.25rem] ${mobileRowsClass} md:grid-cols-[3.5rem_1fr_1fr_1fr_3.5rem] md:grid-rows-3`}
    >
      <!-- Subtítulo (apenas desktop) -->
      <div
        class="col-start-2 row-start-1 hidden self-start pt-24 pl-2 md:block"
      >
        <h2 class="text-2xl font-semibold leading-snug text-foreground">
          Web Designer &amp;<br />
          Desenvolvedor FrontEnd
        </h2>
      </div>

      <!-- Texto central (apenas desktop) -->
      <div
        class="col-start-3 row-start-1 hidden self-start pt-24 pl-2 md:block"
      >
        <p class="font-mono text-sm leading-relaxed text-foreground">
          Código que funciona<span class="text-primary">.</span><br />
          Design que comunica<span class="text-primary">.</span>
        </p>
      </div>

      <!-- Texto à direita / descrição (apenas desktop, versão mobile está agrupada abaixo) -->
      <div
        class="col-start-4 row-start-1 hidden self-start pt-24 pl-2 md:block"
      >
        <p class="font-mono text-sm leading-relaxed text-foreground">
          {bio}
        </p>
      </div>

      <!-- Título principal -->
      <div
        class="col-start-2 col-span-2 row-start-1 self-start pt-20 pl-2 md:col-start-2 md:col-span-3 md:row-start-3 md:self-end md:pt-0 md:pb-24"
      >
        <h1
          class="text-4xl font-extrabold uppercase leading-none text-foreground md:text-6xl font-wide"
        >
          Onde técnica<br />
          encontra <span class="text-primary">estilo</span>
        </h1>
      </div>

      <!-- Bloco inferior (mobile): descrição + relógio/ícone -->
      <div
        class="col-start-2 col-span-2 row-start-3 flex h-full flex-col justify-end gap-4 pb-6 pl-2 md:hidden"
      >
        <p class="font-mono text-sm leading-relaxed text-foreground pb-2.5">
          {bio}
        </p>
        <div class="flex items-center justify-between pr-4">
          <Clock class="whitespace-nowrap font-mono text-sm text-foreground" />
          <AnimatedGlobe class="h-7 w-14" />
        </div>
      </div>

      <!-- Relógio (apenas desktop) -->
      <div
        class="col-start-2 row-start-3 hidden self-end justify-self-start whitespace-nowrap pb-8 pl-2 font-mono text-sm text-foreground md:block"
      >
        <Clock class="whitespace-nowrap font-mono text-sm text-foreground" />
      </div>

      <!-- Posição do mouse (apenas desktop) -->
      <div
        class="col-start-3 row-start-3 hidden self-end justify-self-center whitespace-nowrap pb-8 font-mono text-sm text-foreground md:block"
      >
        <span id="mouse-position">X: --- Y: ---</span>
      </div>

      <!-- Ícone (apenas desktop) -->
      <div
        class="col-start-4 row-start-3 hidden self-end justify-self-end pb-8 pr-4 md:block"
      >
        <AnimatedGlobe class="h-7 w-14" />
      </div>
    </div>
  </div>
</section>

<script>
  const mousePositionEl = document.getElementById('mouse-position')
  const heroSection = document.getElementById('hero-section')
  const heroGridRed = document.getElementById('hero-grid-red')

  document.addEventListener('mousemove', (event) => {
    if (mousePositionEl) {
      mousePositionEl.textContent = `X: ${event.clientX} Y: ${event.clientY}`
    }

    if (heroSection && heroGridRed) {
      const rect = heroSection.getBoundingClientRect()
      const x = event.clientX - rect.left
      const y = event.clientY - rect.top
      const inside = x >= 0 && x <= rect.width && y >= 0 && y <= rect.height

      heroSection.style.setProperty('--mx', `${x}px`)
      heroSection.style.setProperty('--my', `${y}px`)
      heroGridRed.style.opacity = inside ? '1' : '0'
    }
  })
</script>
